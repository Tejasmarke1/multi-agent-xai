# Copy this file to .env and fill in your key.
# Without a key, the pipeline still runs end-to-end (retrieval, embeddings,
# graph-building, scoring all work) but summaries/explanations will be
# clearly-labeled offline placeholders instead of real LLM reasoning.
GOOGLE_API_KEY=
ARXIV_DELAY_SECONDS=10

# Optional overrides — see config.py for the full list of tunables.
# LLM_MODEL=gemini-2.5-flash
